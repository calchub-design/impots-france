# =============================================================================
# The Last Block — configuration de la BÊTA PRIVÉE 48 h (modèle, aucun secret réel)
# =============================================================================
# Copier vers un fichier lisible par le seul service, ex. /etc/the-last-block/beta.env
# (chmod 600). Ne jamais committer le fichier rempli. Voir docs/BETA-48H.md.
#
# Au démarrage, BETA_MODE=true REFUSE de lancer le serveur si un réglage est dangereux
# (accès ouvert, secret trop court, base par défaut, origine non https, limites modifiées…).

# --- Mode bêta -----------------------------------------------------------------
BETA_MODE=true
# Création de compte uniquement avec un code d'invitation (vérifié côté serveur).
ACCESS_MODE=invite

# --- Secrets (à générer, jamais dans le client, jamais dans le dépôt) ----------
# openssl rand -base64 48
ADMIN_TOKEN=
# Clé des pseudonymes de l'export statistique (HMAC). Différente de ADMIN_TOKEN.
# La détruire à la fin de la bêta rend les pseudonymes définitivement non reliables.
# openssl rand -base64 48
STATS_PSEUDONYM_SECRET=

# --- Serveur -------------------------------------------------------------------
# Écoute locale uniquement : seul le reverse proxy HTTPS (Caddy) est exposé.
HOST=127.0.0.1
PORT=8080
# Base DÉDIÉE à la bêta (jamais la base par défaut ni celle d'un autre environnement).
DB_PATH=/var/lib/the-last-block/beta-48h.sqlite
BACKUP_DIR=/var/lib/the-last-block/backups
STATIC_DIR=./dist/client
# Origine(s) https exactes de la bêta (WebSocket refusé depuis toute autre origine).
ALLOWED_ORIGINS=https://beta.exemple.fr
# Derrière Caddy uniquement (qui ajoute X-Forwarded-For).
TRUST_PROXY=true
SQLITE_SYNCHRONOUS=FULL

# --- Limites (identiques à la production : ne pas modifier) ---------------------
MAX_ACTIONS_PER_SECOND=5
DAILY_ACTIVE_LIMIT_MINUTES=240
IDLE_GAP_SECONDS=5
BRIGADE_MIN_SIZE=5
BRIGADE_MAX_SIZE=10
MAX_CONNECTIONS_PER_IP=20
NEW_ACCOUNTS_PER_IP_PER_HOUR=30
MAX_CONNECTIONS_PER_ACCOUNT=4

# --- Saison de 48 h ----------------------------------------------------------
# La saison est lancée À LA MAIN par l'administration (heure choisie), pas au démarrage.
AUTO_START_SEASON=false
SEASON_DURATION_HOURS=48
DISCOVERY_PROFILE=mini-48h
# Préréglage CENTRAL (15 invités, activité moyenne) : npm run calibrate -- --beta
# Ces valeurs servent de défaut ; le démarrage administratif peut les préciser.
CUBE_SIZE=12
BLOCK_BASE_HP=35
BLOCK_HP_PER_LAYER=7
LEADERBOARD_SIZE=10

# --- Désactivés pendant la bêta ---------------------------------------------------
DONATION_DISPLAY_ENABLED=false
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
