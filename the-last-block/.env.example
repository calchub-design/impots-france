# --- Serveur -----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Fichier SQLite (créé automatiquement). Utilisez un volume persistant en production.
DB_PATH=./data/lastblock.sqlite
# Dossier du client compilé servi par le serveur (npm run build).
STATIC_DIR=./dist/client
# Origines autorisées pour le WebSocket, séparées par des virgules.
# Vide = toutes acceptées (développement uniquement).
ALLOWED_ORIGINS=
# Derrière un reverse proxy de confiance uniquement : lire l'IP client dans X-Forwarded-For
# (dernière valeur). Laisser à false si le serveur est exposé directement.
TRUST_PROXY=false
# Limites anti-abus par adresse IP et par compte.
MAX_CONNECTIONS_PER_IP=20
NEW_ACCOUNTS_PER_IP_PER_HOUR=30
MAX_CONNECTIONS_PER_ACCOUNT=4
# NORMAL : aucune perte si le processus est tué ; FULL : durable aussi en cas de coupure électrique.
SQLITE_SYNCHRONOUS=NORMAL
# Jeton des routes /api/admin/* (Authorization: Bearer ...). Vide = routes désactivées.
# Générez une valeur longue et aléatoire, ex. : openssl rand -base64 32
ADMIN_TOKEN=

# --- Règles du jeu -------------------------------------------------------------
# Pour une saison de ~30 jours : npm run calibrate -- --days 30 --players 200 --minutes 30
# Cube de CUBE_SIZE^3 blocs (1 à 64). 10 => 1 000 blocs.
CUBE_SIZE=10
# Résistance d'un bloc : BLOCK_BASE_HP + couche * BLOCK_HP_PER_LAYER (couche 0 = sommet).
BLOCK_BASE_HP=3
BLOCK_HP_PER_LAYER=1
# 720 h = 30 jours.
SEASON_DURATION_HOURS=168
# Démarre automatiquement une saison au boot et après chaque fin de saison.
AUTO_START_SEASON=true
SEASON_COOLDOWN_SECONDS=60
# Limite par compte, toutes connexions confondues.
MAX_ACTIONS_PER_SECOND=5
# Temps de minage ACTIF maximum par jour UTC.
DAILY_ACTIVE_LIMIT_MINUTES=240
# Fenêtre d'activité : chaque coup rend actif pendant ce temps ; une pause plus longue
# n'est comptée que pour cette durée (voir docs/ARCHITECTURE.md).
IDLE_GAP_SECONDS=5
BRIGADE_MIN_SIZE=5
BRIGADE_MAX_SIZE=10
LEADERBOARD_SIZE=10

# --- Association (affichage uniquement, AUCUNE transaction) -------------------
DONATION_DISPLAY_ENABLED=false
DONATION_ASSOCIATION_NAME=
# Seules les URL https:// sont affichées comme lien.
DONATION_ASSOCIATION_URL=
DONATION_NOTE=

# --- Connexion externe (NON implémentée : ces valeurs n'activent rien) --------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
